# 统一换行策略：仓库内一律 LF，检出时按平台/类型决定
# 目的：Windows 上开发、Linux 云服务器上训练，脚本不能带着 CRLF 过去
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.bat  text eol=crlf

# 二进制文件：禁止任何换行/编码转换
*.bin    binary
*.npz    binary
*.onnx   binary
*.wasm   binary
*.mjb    binary
*.png    binary
*.jpg    binary
*.mp4    binary
*.pem    binary
